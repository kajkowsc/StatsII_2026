LB.6 = -0.6812987
UB.6 = -0.1881094
PE.6 = -0.4681287
UL = c(UB.1, UB.2, UB.3, UB.4, UB.5, UB.6)
LL = c(LB.1, LB.2, LB.3, LB.4, LB.5, LB.6)
PredictedProb = c(PE.1, PE.2, PE.3, PE.4, PE.5, PE.6)
PredictedProb
